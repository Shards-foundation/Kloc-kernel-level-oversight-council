{
  "name": "kloc-oversight-council",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "KLOC five-model oversight council with optional free/local backup sub-seats",
  "scripts": {
    "dev": "concurrently --kill-others \"node server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "keywords": [
    "ai",
    "governance",
    "oversight",
    "adversarial",
    "shards"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^7.0.2",
    "vite": "^7.1.0"
  }
}
