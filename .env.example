# Configure ALL FIVE server-only provider credentials before running a review.
# Do not store real keys in this repository or in Vite/client environment variables.
ANTHROPIC_API_KEY=replace-with-anthropic-key
OPENAI_API_KEY=replace-with-openai-key
GEMINI_API_KEY=replace-with-google-key
XAI_API_KEY=replace-with-xai-key
MISTRAL_API_KEY=replace-with-mistral-key

# Optional: select a different supported model for each provider.
KLOC_ANTHROPIC_MODEL=claude-sonnet-5-5
KLOC_OPENAI_MODEL=gpt-6.1-terra
KLOC_GEMINI_MODEL=gemini-3.8-flash
KLOC_XAI_MODEL=grok-4.7
KLOC_MISTRAL_MODEL=mistral-small-latest

# The HTTP service must remain loopback-only until secure auth is implemented.
HOST=127.0.0.1
PORT=8787
