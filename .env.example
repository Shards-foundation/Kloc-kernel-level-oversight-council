# Configure ALL FIVE server-only provider credentials before running a review.
# Do not store real keys in this repository or in Vite/client environment variables.
ANTHROPIC_API_KEY=replace-with-anthropic-key
OPENAI_API_KEY=replace-with-openai-key
GEMINI_API_KEY=replace-with-google-key
XAI_API_KEY=replace-with-xai-key
MISTRAL_API_KEY=replace-with-mistral-key

# Optional: select a different supported model for each provider.
KLOC_ANTHROPIC_MODEL=claude-sonnet-5-5
KLOC_OPENAI_MODEL=gpt-6.1-terra
KLOC_GEMINI_MODEL=gemini-3.8-flash
KLOC_XAI_MODEL=grok-4.7
KLOC_MISTRAL_MODEL=mistral-small-latest

# Optional backup sub-seat layer (OFF by default).
# KLOC will run one registered backup reviewer if its primary seat fails.
# A backup may come from Ollama, LM Studio or an explicitly named OpenRouter :free model.
# All selected reviewers must use different model identifiers.
#
# KLOC_SUBSEATS_JSON must be a SINGLE LINE JSON array. Do not put credentials or URLs in it.
# Example (adjust to models actually installed and available):
# KLOC_SUBSEATS_ENABLED=true
# KLOC_SUBSEATS_JSON=[{"seat":"SECURITY","provider":"ollama","model":"qwen3:8b","priority":5},{"seat":"SYSTEMS_INTEGRITY","provider":"lmstudio","model":"local/qwen3-14b","priority":10},{"seat":"FOUNDER_ADVERSARY","provider":"openrouter","model":"google/gemma-3-4b-it:free","priority":20}]
#
# KLOC runs local model servers on its OWN machine, not automatically on your phone.
# Ollama: http://127.0.0.1:11434/api/chat
# LM Studio: http://127.0.0.1:1234/v1/chat/completions
# Confirm installed/available model IDs on those runtimes before enabling.
KLOC_SUBSEATS_ENABLED=false
KLOC_SUBSEATS_JSON=[]
OPENROUTER_API_KEY=replace-with-openrouter-key

# The HTTP service must remain loopback-only until secure auth is implemented.
HOST=127.0.0.1
PORT=8787
